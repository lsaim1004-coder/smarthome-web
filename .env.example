# copy to .env and set real values (.env is git-ignored)
DB_PASSWORD=change-me

# 공개 URL
APP_BASE_URL=https://iot.kiwan.kr
APP_ADMIN_URL=https://iot-admin.kiwan.kr

# 인증 메일 발송
#  log  : 메일을 보내지 않고 백엔드 로그와 API 응답(devCode)에 인증번호 표시 (개발용)
#  smtp : 아래 SMTP 계정으로 실제 발송 (예: Gmail 앱 비밀번호, smtp.gmail.com:587)
APP_MAIL_MODE=log
APP_MAIL_HOST=
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@example.com
APP_MAIL_STARTTLS=true

# 상담 접수 알림을 받고 관리자(OWNER)로 로그인할 이메일 (콤마 구분)
APP_ADMIN_EMAILS=

# 가전 사진 자동판별. 키가 없으면 구매시기·브랜드 규칙으로만 채운다.
APP_ANALYSIS_ENABLED=true
APP_ANALYSIS_API_KEY=
APP_ANALYSIS_MODEL=claude-sonnet-5
# 모델명을 읽어낸 뒤 사진 원본을 지운다
APP_ANALYSIS_PURGE_AFTER=true

# 관리자 컨테이너가 사진을 가져올 때 쓰는 내부 키 (배포 스크립트가 없으면 만들어 준다)
APP_INTERNAL_KEY=
